# ─── App ────────────────────────────────────────────────────────────────────
APP_NAME="KnowledgeBot"
APP_VERSION="1.0.0"
DEBUG=false
FRONTEND_ORIGIN="http://localhost:5173"

# ─── Security ────────────────────────────────────────────────────────────────
SECRET_KEY="CHANGE_ME_use_openssl_rand_hex_32"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Model (HuggingFace local) ───────────────────────────────────────────────
# Lightweight model for CPU-only machines; swap for larger if GPU available
LLM_MODEL_ID="microsoft/phi-2"          # ~2.7B params, runs on CPU
EMBEDDING_MODEL_ID="all-MiniLM-L6-v2"  # fast, accurate sentence embeddings
MAX_NEW_TOKENS=512
TEMPERATURE=0.3
TOP_P=0.9

# ─── Vector Store ────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR="./knowledge_base/chroma_db"
COLLECTION_NAME="knowledge_base"

# ─── Retrieval ───────────────────────────────────────────────────────────────
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.35
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL="INFO"
LOG_DIR="./logs"
LOG_ROTATION="10 MB"
LOG_RETENTION="30 days"
